# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model (default llama-3.3-70b-versatile, auto-falls back if retired)
GROQ_MODEL=
# Neon Postgres (free): https://neon.tech -> connection string
DATABASE_URL=
# Tavily web search (free 1,000 credits/month, only used when you tap Allow): https://tavily.com
TAVILY_API_KEY=
# Any passcode you like; the app asks for it once on your phone
APP_PASSCODE=
# Local testing only: fake AI responses
MOCK_AI=
